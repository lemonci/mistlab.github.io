---
layout: layouts/base.njk
title: ""
description: "The MIST Lab pushes the boundaries of autonomous robotics at Polytechnique Montréal — from swarms of drones to lunar rovers."
---

<!-- HERO -->
<section class="hero" id="home">
  <div class="hero-bg">
    <img src="{{ '/assets/images/missions/mission8.jpg' | url }}" alt="" aria-hidden="true">
  </div>
  <!-- Rotating MIST acronym — word lists live in _data/acronym.yaml -->
  <h2 class="hero-acronym" id="mist-acronym" title="MIST has no fixed meaning…">
    <span class="mist-word" id="mist-m">{{ acronym.m[0] }}</span>
    <span class="mist-word" id="mist-i">{{ acronym.i[0] }}</span>
    <span class="mist-word" id="mist-s">{{ acronym.s[0] }}</span>
    <span class="mist-word" id="mist-t">{{ acronym.t[0] }}</span>
    <span class="hero-acronym-lab">Lab</span>
  </h2>
  <div class="hero-content">
    <div class="hero-eyebrow">Polytechnique Montréal · Autonomous Robotics</div>
    <h1>Robotics at<br>the Edge of<br><em>the Possible</em></h1>
    <p class="hero-sub">The MIST Lab pushes the boundaries of autonomous robotics — from swarms of drones to lunar rovers, to caves and planetary surfaces — operating where infrastructure ends.</p>
    <div class="hero-actions">
      <a href="{{ '/projects/' | url }}" class="btn-primary">Explore Research</a>
      <a href="#contact" class="btn-ghost">Join the Lab</a>
    </div>
  </div>
  <div class="hero-logos">
    <img src="{{ '/assets/images/university_logo.png' | url }}" alt="Polytechnique Montréal">
  </div>
</section>

<!-- OPEN SOURCE STRIP -->
<div style="background:rgba(74,158,255,0.07); border-top:1px solid rgba(74,158,255,0.15); border-bottom:1px solid rgba(74,158,255,0.15); padding:14px 72px; display:flex; align-items:center; gap:24px;">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="2" style="flex-shrink:0"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
  <span style="font-family:var(--font-mono); font-size:12px; letter-spacing:0.1em; text-transform:uppercase; color:var(--blue);">Open Source</span>
  <span style="color:var(--muted); font-size:14px; font-weight:300;">We release our research as open-source software. Explore our repos on GitHub.</span>
  <a href="{{ site.github }}" target="_blank" style="margin-left:auto; font-family:var(--font-head); font-weight:700; font-size:13px; letter-spacing:0.05em; text-transform:uppercase; color:var(--blue); text-decoration:none; white-space:nowrap; border:1px solid rgba(74,158,255,0.3); padding:7px 16px; border-radius:4px; transition:border-color .2s;">github.com/MISTLab →</a>
</div>

<!-- STATS BAR -->
<div class="stats-bar">
  {% for stat in site.stats %}
    <div class="stat-item">
      <div class="stat-num">{{ stat.num }}<span>{{ stat.suffix }}</span></div>
      <div class="stat-label">{{ stat.label }}</div>
    </div>
  {% endfor %}
</div>

<!-- RESEARCH -->
<section id="research">
  <div class="research-header reveal">
    <div>
      <div class="section-label">Research Areas</div>
      <h2>Where We Push<br>the Frontier</h2>
    </div>
    <p class="research-intro">From autonomous swarms navigating caves to AI-powered field robots operating in extreme environments — our work drives the next generation of intelligent systems.</p>
  </div>
  <div class="research-grid reveal">
    {% for project in projects | featured %}
      <div class="research-card">
        <div class="research-icon">{{ project.icon | safe }}</div>
        <h3>{{ project.title }}</h3>
        <p>{{ project.description }}</p>
      </div>
    {% endfor %}
  </div>
  <div style="text-align:right; margin-top:32px;" class="reveal">
    <a href="{{ '/projects/' | url }}" class="btn-ghost" style="font-size:13px; padding:10px 20px;">All Projects →</a>
  </div>
</section>

<!-- PEOPLE -->
<section id="people" style="background: var(--bg);">
  <div class="section-label reveal">The Team</div>
  <h2 class="reveal">Faculty &amp; Researchers</h2>
  <div class="professors-grid reveal">
    {% for person in collections.people | byRole("faculty") %}
      <a href="{{ person.url | url }}" class="prof-card" style="text-decoration:none; color:inherit;">
        <div class="prof-photo" style="background: linear-gradient(135deg, #13161d, #1e2535);">
          {% if person.data.photo %}
            <img src="{{ ('/assets/images/people/' + person.data.photo) | url }}" alt="{{ person.data.name }}">
          {% else %}
            <div class="prof-photo-placeholder">{{ person.data.name | initials }}</div>
          {% endif %}
        </div>
        <div class="prof-info">
          <h3>{{ person.data.name }}</h3>
          <div class="prof-title">{{ person.data.title }}</div>
          <p>{{ person.data.short_bio }}</p>
          <div class="prof-tags">
            {% for tag in person.data.tags %}
              <span class="tag">{{ tag }}</span>
            {% endfor %}
          </div>
        </div>
      </a>
    {% endfor %}
  </div>

  <div class="team-photo-strip reveal">
    <img src="{{ '/assets/images/team_photo.jpg' | url }}" alt="MIST Lab Team">
    <div class="team-photo-strip-overlay">
      <div class="team-strip-text">
        <h3>A World-Class Team</h3>
        <p>Researchers, engineers, and explorers united by a passion for pushing autonomous systems beyond their limits.</p>
        <div class="team-strip-stats">
          <div class="strip-stat">
            <div class="num">{{ collections.people | byRole("phd") | length }}</div>
            <div class="lbl">PhD Students</div>
          </div>
          <div class="strip-stat">
            <div class="num">{{ collections.people | byRole("msc") | length }}</div>
            <div class="lbl">MSc Students</div>
          </div>
          <div class="strip-stat">
            <div class="num">{{ (collections.people | byRole("postdoc") | length) + (collections.people | byRole("research_associate") | length) }}</div>
            <div class="lbl">Postdocs &amp; RAs</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div style="text-align:right; margin-top:32px;" class="reveal">
    <a href="{{ '/people/' | url }}" class="btn-ghost" style="font-size:13px; padding:10px 20px;">Full Team →</a>
  </div>
</section>

<!-- FIELD MISSIONS -->
<section id="missions" style="background: var(--surface);">
  <div class="section-label reveal">Field Missions</div>
  <h2 class="reveal">From the Lab<br>to the Edge of the World</h2>
  <div class="missions-grid reveal">
    {% for mission in missions.tiles %}
      <div class="mission-tile {{ mission.css_class }}">
        <img src="{{ ('/assets/images/missions/' + mission.image) | url }}" alt="{{ mission.label }}">
        <div class="mission-tile-label">{{ mission.label }}</div>
      </div>
    {% endfor %}
  </div>
  <div class="missions-partners reveal">
    {% for partner in missions.partners %}
      <span class="partner-badge">{{ partner }}</span>
    {% endfor %}
  </div>
</section>

<!-- NEWS -->
<section id="news" style="background: var(--bg);">
  <div class="section-label reveal">News</div>
  <h2 class="reveal">Latest from the Lab</h2>
  <div class="news-grid reveal">
    {% for item in news | sortByDate | limit(3) %}
      <div class="news-card">
        <div class="news-img">
          <img src="{{ ('/assets/images/missions/' + item.image) | url }}" alt="{{ item.title }}">
        </div>
        <div class="news-body">
          <div class="news-date">{{ item.date | truncate(7, true, "") | replace("-", " ") }}</div>
          <h3>{{ item.title }}</h3>
          <p>{{ item.summary }}</p>
          {% if item.tag %}
            <span class="news-tag">→ {{ item.tag }}</span>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  <div style="text-align:right; margin-top:32px;" class="reveal">
    <a href="{{ '/news/' | url }}" class="btn-ghost" style="font-size:13px; padding:10px 20px;">All News →</a>
  </div>
</section>

<!-- TEACHING -->
<section id="teaching" style="background: var(--surface);">
  <div class="section-label reveal">Education</div>
  <h2 class="reveal">Teaching</h2>
  <div class="teaching-grid reveal">
    {% for course in courses %}
      <div class="course-card">
        <div class="course-code">{{ course.code }} · {{ course.level }}</div>
        <h3>{{ course.title }}</h3>
        <p>{{ course.description }}</p>
      </div>
    {% endfor %}
  </div>
  <div style="text-align:right; margin-top:32px;" class="reveal">
    <a href="{{ '/teaching/' | url }}" class="btn-ghost" style="font-size:13px; padding:10px 20px;">Courses &amp; Prospective Students →</a>
  </div>
</section>

<!-- CONTACT / JOIN -->
<section id="contact" style="background: var(--bg);">
  <div class="contact-layout">
    <div class="contact-text reveal">
      <div class="section-label">Join Us</div>
      <h2>Come Build the<br>Future of Robotics</h2>
      <p>We're always looking for motivated PhD and MSc candidates passionate about autonomous systems, field robotics, and space applications. Funded positions available.</p>
      <div class="contact-actions">
        {% for person in collections.people | byRole("faculty") %}
        <a href="mailto:{{ person.data.email }}" class="contact-link">
          <div class="contact-link-icon">
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="contact-link-text">
            <strong>{{ person.data.name }}</strong>
            <span>{{ person.data.email }}</span>
          </div>
        </a>
        {% endfor %}
        <a href="{{ site.github }}" target="_blank" class="contact-link">
          <div class="contact-link-icon">
            <svg viewBox="0 0 24 24"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </div>
          <div class="contact-link-text">
            <strong>GitHub</strong>
            <span>github.com/MISTLab</span>
          </div>
        </a>
        <a href="{{ site.university_url }}" target="_blank" class="contact-link">
          <div class="contact-link-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <div class="contact-link-text">
            <strong>Polytechnique Montréal</strong>
            <span>polymtl.ca</span>
          </div>
        </a>
      </div>
    </div>
    <div class="contact-hero-img reveal">
      <img src="{{ '/assets/images/missions/mission1.jpg' | url }}" alt="MIST Lab field mission">
    </div>
  </div>
</section>

<!-- SPIN-OFFS -->
<section id="spinoffs" style="background: var(--surface); padding-top: 48px; padding-bottom: 48px; border-top: 1px solid var(--border);">
  <div style="display:flex; align-items:baseline; gap:16px; margin-bottom:32px;" class="reveal">
    <span style="font-family:var(--font-mono); font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:var(--muted);">Spin-offs</span>
    <span style="font-size:13px; color:var(--muted); font-weight:300;">Companies founded by MIST Lab members</span>
  </div>
  <div class="spinoffs-grid reveal" style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
    {% for company in spinoffs %}
      {% if company.placeholder %}
        <div class="spinoff-card spinoff-placeholder">
          <div class="spinoff-logo-wrap">
            <span style="font-family:var(--font-mono); font-size:10px; letter-spacing:0.12em; color:var(--muted);">+ ADD</span>
          </div>
          <h3 style="color: var(--muted);">{{ company.name }}</h3>
          <p class="spinoff-desc" style="color: var(--muted);">{{ company.description }}</p>
          <span class="spinoff-link" style="color: var(--muted);">{{ company.link_label }}</span>
        </div>
      {% else %}
        <a href="{{ company.url }}" target="_blank" class="spinoff-card">
          <div class="spinoff-logo-wrap">
            {% if company.logo %}
              <img src="{{ ('/assets/images/' + company.logo) | url }}" alt="{{ company.name }}" style="height:28px;">
            {% else %}
              <span style="font-family:var(--font-head); font-size:16px; font-weight:700; color:var(--text);">{{ company.name }}</span>
            {% endif %}
          </div>
          <h3>{{ company.name }}</h3>
          <p class="spinoff-desc">{{ company.description }}</p>
          <span class="spinoff-link">{{ company.link_label }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

<!-- Rotating MIST acronym in the hero — edit the word lists in _data/acronym.yaml -->
<script>window.mistWords = {{ acronym | dump | safe }};</script>
<script src="{{ '/assets/js/acronym.js' | url }}"></script>
