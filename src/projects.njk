<div class="page-header">
  <div class="section-label">Research</div>
  <h1>Research Projects</h1>
  <p>Our work spans robot autonomy, swarm intelligence, field robotics, and software engineering for robotic systems.</p>
</div>

<!-- RESEARCH AREAS OVERVIEW -->
<section style="background: var(--surface);">
  <div class="section-label reveal">Research Areas</div>
  <h2 class="reveal">Where We Push<br>the Frontier</h2>
  <div class="research-grid reveal">
    {% for project in projects | featured %}
      <div class="research-card">
        <div class="research-icon">{{ project.icon | safe }}</div>
        <h3>{{ project.title }}</h3>
        <p>{{ project.description }}</p>
      </div>
    {% endfor %}
  </div>
</section>

