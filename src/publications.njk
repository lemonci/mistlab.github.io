---
layout: layouts/base.njk
title: Publications
permalink: /publications/
---

<div class="page-header">
  <div class="section-label">Research Output</div>
  <h1>Publications</h1>
</div>

<section id="publications" style="background: var(--bg);">
  <div class="pub-layout">
    <div class="pub-aside reveal">
      <div class="section-label">Count</div>
      <h2>Research<br>Output</h2>
      <div class="pub-big-num">
        100+
      </div>
      {% if publications.generated_at %}
        <div style="font-family:var(--font-mono); font-size:11px; color:var(--muted); margin-top:16px; letter-spacing:0.08em;">
          Last updated<br>{{ publications.generated_at | truncate(10, true, "") }}
        </div>
      {% endif %}
      <div style="margin-top:32px; display:flex; flex-direction:column; gap:12px;">
        {% for person in collections.people | byRole("faculty") %}
          {% if person.data.scholar %}
            <a href="https://scholar.google.com/citations?user={{ person.data.scholar }}" target="_blank" style="font-family:var(--font-mono); font-size:11px; color:var(--blue); text-decoration:none; letter-spacing:0.04em; border:1px solid rgba(74,158,255,0.3); padding:8px 12px; border-radius:3px;">{{ person.data.name }} → Scholar</a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="pub-list reveal">
      {% if publications.publications and publications.publications.length > 0 %}
        {% set current_year = "" %}
        {% for pub in publications.publications %}
          {% if pub.year != current_year %}
            {% set current_year = pub.year %}
            <div style="padding:32px 0 8px; font-family:var(--font-head); font-size:24px; font-weight:800; color:var(--blue); opacity:0.5; letter-spacing:-0.02em;">{{ pub.year }}</div>
          {% endif %}
          {% if pub.doi %}
            <a class="pub-item" href="{{ pub.doi }}" target="_blank">
          {% else %}
            <div class="pub-item">
          {% endif %}
            <div class="pub-year">{{ pub.year }}</div>
            <div class="pub-title">
              {{ pub.title }}
              {% if pub.authors %}<span>{{ pub.authors }}</span>{% endif %}
            </div>
            {% if pub.venue %}
              <div class="pub-venue">{{ pub.venue | truncate(35, true, "…") }}</div>
            {% else %}
              <div class="pub-venue"></div>
            {% endif %}
          {% if pub.doi %}</a>{% else %}</div>{% endif %}
        {% endfor %}
      {% else %}
        <div style="padding:60px 0; color:var(--muted); font-size:15px; line-height:1.8;">
          <p style="margin-bottom:24px;">Publications are fetched weekly from ORCID.</p>
          <p style="margin-bottom:24px;">To populate this page:</p>
          <ol style="padding-left:24px; color:var(--muted); font-size:14px;">
            <li style="margin-bottom:8px;">Make sure each PI's file in <code style="font-family:var(--font-mono); font-size:12px; color:var(--blue);">src/people/</code> has an <code style="font-family:var(--font-mono); font-size:12px; color:var(--blue);">orcid:</code> field</li>
            <li style="margin-bottom:8px;">Run <code style="font-family:var(--font-mono); font-size:12px; color:var(--blue);">npm run fetch-pubs</code> locally, or</li>
            <li>Trigger the <em>Update Publications from ORCID</em> GitHub Action</li>
          </ol>
          <div style="margin-top:32px;">
            <a href="https://scholar.google.com/citations?user={{ site.google_scholar }}" target="_blank" class="btn-ghost" style="font-size:13px; padding:10px 20px;">View on Google Scholar →</a>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>
